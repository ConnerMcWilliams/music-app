# Copy to `.env` for local development. Never commit the real `.env`.

# Django
SECRET_KEY=dev-insecure-change-me
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1

# Database — points at the local Docker Postgres (see docker-compose.yml).
# In production, set this to the Neon/Railway connection string instead.
DATABASE_URL=postgres://studies:studies@localhost:5432/studies

# CORS — which frontend origins may call the API from a browser (Expo web,
# dev preview). Native app builds don't need this. In dev, CORS_ALLOW_ALL_ORIGINS
# defaults to DEBUG=on, so you can leave the explicit list empty locally.
# In production: CORS_ALLOW_ALL_ORIGINS=0 and list your real web origins here.
CORS_ALLOW_ALL_ORIGINS=1
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006
