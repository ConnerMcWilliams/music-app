# Copy to `.env` for local development. Never commit the real `.env`.

# Django
# SECRET_KEY also signs the JWT access/refresh tokens (HS256) and the unsubscribe
# links. Keep it secret. REQUIRED in production: when DEBUG=0 a served boot fails
# fast (ImproperlyConfigured) if this is still the dev default.
SECRET_KEY=dev-insecure-change-me
DEBUG=1

# HTTPS/security hardening (production). These auto-enable when DEBUG=0 (and are
# off during test runs). Set/override only if your platform differs.
# SECURE_SSL_REDIRECT: redirect http→https. Set to 0 if the edge already forces
#   https and you hit a redirect loop.
# SECURE_HSTS_SECONDS: HSTS max-age (default 63072000 = 2y in prod, 0 in dev).
# SECURE_HSTS_PRELOAD: opt-in only — submitting to the browser preload list is a
#   long-lived commitment. Leave unset until you're sure.
# USE_PROXY_SSL_HEADER: trust X-Forwarded-Proto from the TLS-terminating proxy
#   (default on in prod). Turn off only if not behind such a proxy.
# SECURE_SSL_REDIRECT=1
# SECURE_HSTS_SECONDS=63072000
# SECURE_HSTS_PRELOAD=0
# USE_PROXY_SSL_HEADER=1

# Logging verbosity (optional). Defaults to DEBUG locally, INFO in production.
# LOG_LEVEL=INFO
# Hosts Django will serve. Leave this unset in dev: with DEBUG=1 any Host is
# accepted, which is handy because a phone/emulator reaches the dev machine over
# a LAN IP that changes with DHCP. In production, set it to your real hostnames
# (comma-separated), e.g. ALLOWED_HOSTS=api.example.com
# ALLOWED_HOSTS=

# JWT token lifetimes (optional — sensible defaults are used if unset).
# Access tokens are short-lived; refresh tokens are rotated on use.
ACCESS_TOKEN_LIFETIME_MINUTES=15
REFRESH_TOKEN_LIFETIME_DAYS=7

# Endpoint throttling (optional). DRF rate strings, e.g. "10/min".
THROTTLE_AUTH_LOGIN=10/min
THROTTLE_AUTH_REGISTER=5/min
THROTTLE_AUTH_GOOGLE=10/min
# Per-user cap on submission uploads (authenticated endpoint).
THROTTLE_SUBMISSIONS=20/min
# Public marketing-site waitlist form (per client IP).
THROTTLE_WAITLIST=10/hour
# Public marketing-site contact form (per client IP).
THROTTLE_CONTACT=10/hour
# Public newsletter unsubscribe link (per client IP).
THROTTLE_UNSUBSCRIBE=30/hour
# Public updates feed for the marketing site (per client IP).
THROTTLE_UPDATES_PUBLIC=120/hour
# Public page-visit beacon for the marketing site (per client IP).
THROTTLE_ANALYTICS=120/hour

# Google Sign-In — comma-separated OAuth client IDs accepted as the ID-token
# audience. Always include the Web client ID (Android tokens carry it); add the
# iOS client ID too (iOS tokens may carry it). Sign-in is disabled when unset.
# GOOGLE_OAUTH_CLIENT_IDS=<web-id>.apps.googleusercontent.com,<ios-id>.apps.googleusercontent.com

# Database — points at the local Docker Postgres (see docker-compose.yml).
# Host port is 5433 to avoid clashing with a native Postgres on 5432.
# In production, set this to the Neon/Railway connection string instead.
DATABASE_URL=postgres://studies:studies@localhost:5433/studies

# CORS — which frontend origins may call the API from a browser (Expo web,
# dev preview, and the marketing site's waitlist form). Native app builds don't
# need this. In dev, CORS_ALLOW_ALL_ORIGINS defaults to DEBUG=on, so you can
# leave the explicit list empty locally. In production: CORS_ALLOW_ALL_ORIGINS=0
# and list your real web origins here, including the marketing site's domain
# (e.g. https://www.example.com) or waitlist signups fail at CORS preflight.
# Ports: 8081/19006 Expo, 3000 marketing site, 3100 admin dashboard. In
# production, add the deployed admin dashboard's origin too or every dashboard
# request fails at CORS preflight.
CORS_ALLOW_ALL_ORIGINS=1
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006,http://localhost:3000,http://localhost:3100

# Email — sends a notification to the site owner when the marketing site's
# contact form is submitted. Leave EMAIL_BACKEND unset in dev: with DEBUG=1 it
# defaults to the console backend, which prints the message to the terminal (no
# SMTP account needed). For production, configure SMTP below (Gmail shown).
# EMAIL_HOST_PASSWORD is a secret — set it in the deploy environment, never here.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=1
# EMAIL_HOST_USER=connermcwilliams16@gmail.com
# EMAIL_HOST_PASSWORD=<gmail-app-password>
# DEFAULT_FROM_EMAIL must match EMAIL_HOST_USER for Gmail SMTP.
# DEFAULT_FROM_EMAIL=connermcwilliams16@gmail.com
# Where contact-form notifications are delivered (defaults to the owner inbox).
# CONTACT_NOTIFICATION_EMAIL=connermcwilliams16@gmail.com

# Absolute public origin of THIS backend. Used to build the unsubscribe links in
# newsletter emails, so it must be the real https origin in production or the
# links point at localhost. Defaults to http://localhost:8000 in dev.
# BACKEND_BASE_URL=https://api.clarkecoach.com
