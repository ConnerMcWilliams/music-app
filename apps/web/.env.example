# Marketing site environment variables. Copy to `.env` for local overrides.
#
# NEXT_PUBLIC_* values are inlined into the client bundle AT BUILD TIME —
# never put secrets here, and a deployed site must be rebuilt for a new value
# to take effect. Unset, the waitlist form falls back to http://localhost:8000
# (the local Django dev server).
# NEXT_PUBLIC_API_URL=http://localhost:8000
