# Marketing site environment variables. Copy to `.env` for local overrides.
#
# NEXT_PUBLIC_* values are inlined into the client bundle AT BUILD TIME —
# never put secrets here, and a deployed site must be rebuilt for a new value
# to take effect. Unset, the waitlist form falls back to http://localhost:8000
# (the local Django dev server).
#
# Its origin is ALSO baked into the Content-Security-Policy `connect-src` in
# next.config.ts at build time, so if it is wrong the browser will block the
# waitlist/contact/analytics requests. Set it in the build environment.
# NEXT_PUBLIC_API_URL=http://localhost:8000

# Canonical public origin, used for SEO (sitemap, robots, canonical tags,
# absolute Open Graph URLs) and structured data. Defaults to the live domain
# (https://clarkecoach.com); set it if you deploy to a different origin. No
# trailing slash.
# NEXT_PUBLIC_SITE_URL=https://clarkecoach.com
