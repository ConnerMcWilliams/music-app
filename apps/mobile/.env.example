# Mobile app environment variables.
# Copy to `.env` for local development: `cp .env.example .env`
#
# IMPORTANT: Only EXPO_PUBLIC_* variables are readable by the app, and every
# EXPO_PUBLIC_* value is bundled into the client JavaScript. NEVER put secrets
# (API keys, Django SECRET_KEY, database URLs, AWS/service-role credentials)
# in this file — those belong on the backend only.

# Base URL of the Django API the app talks to (used for auth + submissions).
# Use a non-production placeholder locally and in CI.
#
# When unset, the app auto-derives the dev API host from the Metro dev server
# (http://<your-LAN-ip>:8000) so a physical device reaches your machine rather
# than itself — remember `localhost` on a phone is the phone. Run Django with
# `python manage.py runserver 0.0.0.0:8000` and keep the phone on the same LAN.
# See docs/authentication.md → "Local mobile-to-backend networking".
EXPO_PUBLIC_API_URL=https://example.invalid
