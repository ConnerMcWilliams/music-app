# React Native native builds (Gradle/CMake/prefab) + pnpm do not get along with
# pnpm's default isolated store: the `.pnpm/<pkg>@<ver>_<peer-hash>/node_modules/`
# nesting produces paths that blow past Windows' 260-char MAX_PATH during the
# native build (e.g. prefab_command.bat -> "CreateProcess error=2"), and the
# symlinked layout makes autolinking walk parent directories and combine stray
# node_modules trees. A flat, hoisted node_modules keeps native module paths
# short and self-contained.
node-linker=hoisted
